    class SessionProviders,HomePage,FlashcardApp,Header,DesktopNavigation,MobileNavigation coreComponent
    class Flashcard,ModeSelector,MultipleChoice,FlashcardProvider practiceComponent
    class Dashboard,StatsSummary,CharacterProgressTable,SortableHeader,TableRow,TipsModal dashboardComponent
    class FlashcardProvider,SessionProviders contextProvider
    class useDashboardData,useSorting,useAuthStatus,useFlashcardHandlers,useFlashcardInteraction customHook
    class EnvUtils,ErrorUtils,KanaFilter,SubmitUtils,RateLimitUtils utilityLib