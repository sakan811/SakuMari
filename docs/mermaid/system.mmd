---
config:
  theme: 'forest'
  defaultRenderer: "elk"
  layout: elk
---
flowchart TD
    User([👤 User]) --> Browser["🌐 Next.js App Router"]

    Browser --> Auth["🔐 NextAuth.js"]
    Auth --> Session["📝 Session Management"]
    Auth --> Proxy["🛡️ Route Protection"]

    Browser --> Pages["📄 Pages"]
    Pages --> Home["🏠 Home (Public)"]
    Pages --> Practice["⚡ Practice (Protected)"]
    Pages --> Dashboard["📊 Dashboard (Protected)"]

    Practice --> Provider["🎯 FlashcardProvider"]
    Provider --> Components["🃏 UI Components"]

    Components --> API["🔌 API Routes"]
    Dashboard --> API

    API --> Stats["/api/stats"]
    API --> Submit["/api/flashcards/submit"]
    API --> Tips["/api/tips"]
    API --> Health["/api/health"]

    Stats --> Prisma["🗄️ Prisma ORM"]
    Submit --> Prisma
    Tips --> Prisma
    Auth --> Prisma
    Prisma --> DB[(🐘 PostgreSQL)]

    Tips --> Gemini["🤖 Google Gemini AI"]

    Components --> Hooks["⚡ React Hooks"]
    Dashboard --> Hooks

    API --> RateLimit["🚦 Rate Limiting"]
    API --> Utils["🔧 Utility Libraries"]

    RateLimit --> Redis[(🔴 Redis)]

    classDef userLayer fill:#e8f4fd,stroke:#1e40af,stroke-width:2px
    classDef appLayer fill:#fef3c7,stroke:#d97706,stroke-width:2px
    classDef dataLayer fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef aiLayer fill:#fdf4ff,stroke:#a855f7,stroke-width:2px
    classDef infraLayer fill:#fefce8,stroke:#eab308,stroke-width:2px

    class User,Browser userLayer
    class Home,Practice,Dashboard,Provider,Components,API,Hooks,Utils appLayer
    class Prisma,DB dataLayer
    class Auth,Session,Gemini,Proxy,RateLimit,Redis aiLayer