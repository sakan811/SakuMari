    style NextAuth fill:#fdf4ff,stroke:#a855f7,stroke-width:2px,padding:12px
    style Providers fill:#fdf4ff,stroke:#a855f7,stroke-width:2px,padding:12px
    style SubmitAPI fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,padding:12px
    style HealthAPI fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,padding:12px
    style Sitemap fill:#fee2e2,stroke:#dc2626,stroke-width:2px,padding:12px
    style Robots fill:#fee2e2,stroke:#dc2626,stroke-width:2px,padding:12px
    style Favicon fill:#fee2e2,stroke:#dc2626,stroke-width:2px,padding:12px

    class AppRoot,RootLayout rootStructure
    class HomePage,Dashboard,Hiragana,Katakana pageRoute
