---
config:
  theme: 'forest'
  look: handDrawn
  layout: elk
  elk:
    mergeEdges: true
    nodePlacementStrategy: LINEAR_SEGMENTS
---
flowchart LR
    AppRoot["app/"]

    AppRoot --> RootLayout["Root Layout"]
    AppRoot --> Proxy["proxy.ts"]
    AppRoot --> GlobalCSS["Global CSS"]

    AppRoot --> Pages["Pages"]
    Pages --> HomePage["Home Page"]
    Pages --> Dashboard["dashboard/"]
    Pages --> Hiragana["Hiragana Page"]
    Pages --> Katakana["Katakana Page"]

    AppRoot --> API["api/"]
    API --> AuthAPI["auth/"]
    AuthAPI --> NextAuth["NextAuth Route"]
    AuthAPI --> Providers["Auth Providers"]

    API --> AppAPI["App APIs"]
    AppAPI --> SubmitAPI["Submit API"]
    AppAPI --> StatsAPI["stats/"]
    AppAPI --> TipsAPI["tips/"]
    AppAPI --> HealthAPI["Health API"]

    AppRoot --> SEO["SEO"]
    SEO --> Sitemap["Sitemap File"]
    SEO --> Robots["Robots File"]
    SEO --> Favicon["Favicon Icon"]

    Proxy -.-> Dashboard
    Proxy -.-> Hiragana
    Proxy -.-> Katakana
    Proxy -.-> SubmitAPI
    Proxy -.-> StatsAPI
    Proxy -.-> TipsAPI

    classDef rootStructure fill:#e8f4fd,stroke:#1e40af,stroke-width:3px
    classDef pageRoute fill:#fef3c7,stroke:#d97706,stroke-width:2px
    classDef apiRoute fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef authRoute fill:#fdf4ff,stroke:#a855f7,stroke-width:2px
    classDef globalFile fill:#fee2e2,stroke:#dc2626,stroke-width:2px

    class AppRoot,RootLayout rootStructure
    class HomePage,Dashboard,Hiragana,Katakana pageRoute
    class SubmitAPI,StatsAPI,TipsAPI,HealthAPI apiRoute
    class NextAuth,Providers authRoute
    class Proxy,GlobalCSS,Sitemap,Robots,Favicon globalFile