# PostgreSQL Database Configuration
POSTGRES_DB=kana_flashcard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Environment-aware database host configuration
# AUTO_DETECT_DB_HOST=true enables automatic host detection
# When true: uses 'db' in Docker containers, 'localhost' on host
# When false or unset: uses POSTGRES_HOST value
AUTO_DETECT_DB_HOST=true
POSTGRES_HOST=localhost

# Constructed Database URLs (auto-detects host when AUTO_DETECT_DB_HOST=true)
POSTGRES_PRISMA_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
POSTGRES_URL_NON_POOLING=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Authentication
AUTH_URL=http://localhost:3000
AUTH_SECRET=your-random-secret-here
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Docker Configuration
DOCKER_IMAGE_NAME=sakanbeer88/sakumari
DOCKER_IMAGE_TAG=latest
CONTAINER_NAME_PREFIX=sakumari
PULL_POLICY=always

NODE_ENV=production