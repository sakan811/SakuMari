{
  "name": "sakumari",
  "version": "1.0.0",
  "description": "A **Japanese Kana Flashcard** Web App for **practicing** Japanese Kana, specifically Hiragana and Katakana.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "npx prettier . --write",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:reset": "npx prisma migrate reset",
    "prisma:studio": "npx prisma studio",
    "db:seed": "npx prisma db seed",
    "db:setup": "chmod +x scripts/setup-database.sh && ./scripts/setup-database.sh",
    "db:reset": "pnpm prisma:reset && pnpm db:seed",
    "prisma:test": "cross-env PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 npx prisma",
    "test:db:setup": "pnpm prisma:test generate --schema=__tests__/db/schema.prisma && pnpm prisma:test db push --schema=__tests__/db/schema.prisma",
    "test:db": "vitest run --config vitest.config.db.mts",
    "test:db:watch": "vitest --config vitest.config.db.mts",
    "test:db:clean": "cross-env NODE_ENV=test && (rm -f __tests__/db/test.db || del __tests__\\db\\test.db 2>nul || true)",
    "test:db:full": "pnpm test:db:setup && pnpm test:db",
    "test:e2e": "npx playwright test",
    "test:e2e:setup": "docker compose -f docker/docker-compose.yml up -d db && cross-env CREDS_PROVIDER=true ./scripts/setup-database.sh",
    "test:e2e:build": "cross-env CREDS_PROVIDER=true POSTGRES_HOST=localhost pnpm build",
    "test:e2e:full": "pnpm test:e2e:setup && pnpm test:e2e:build && pnpm test:e2e",
    "test:e2e:clean": "docker compose -f docker/docker-compose.yml down --volumes",
    "test:all": "pnpm lint && pnpm format && pnpm test:run && pnpm test:db:full && pnpm test:e2e:full",
    "docker:db": "docker compose -f docker/docker-compose.yml up -d db",
    "docker:db-admin": "docker compose -f docker/docker-compose.yml up -d db dbgate",
    "docker:dev-up": "docker compose -f docker/docker-compose.yml up -d db dbgate app --build",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:logs-app": "docker compose -f docker/docker-compose.yml logs -f app",
    "docker:status": "docker compose -f docker/docker-compose.yml ps",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:clean": "docker compose -f docker/docker-compose.yml down --volumes --rmi all --remove-orphans",
    "k8s:up": "kubectl apply -k k8s/",
    "k8s:logs": "kubectl logs -f deployment/sakumari-app -n sakumari",
    "k8s:logs-app": "kubectl logs -f deployment/sakumari-app -c app -n sakumari",
    "k8s:status": "kubectl get all -n sakumari",
    "k8s:down": "kubectl delete -k k8s/",
    "k8s:clean": "kubectl delete namespace sakumari --wait=false && kubectl delete pvc -l app=sakumari --ignore-not-found=true"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "Sakan Nirattisaykul",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "6.12.0",
    "@vercel/analytics": "^1.5.0",
    "next": "^15.4.6",
    "next-auth": "5.0.0-beta.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.4.6",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "19.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "9.29.0",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
