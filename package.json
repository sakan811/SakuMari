{
  "name": "sakumari",
  "version": "1.0.0",
  "description": "A **Japanese Kana Flashcard** Web App for **practicing** Japanese Kana, specifically Hiragana and Katakana.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "npx prettier . --write",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:reset": "npx prisma migrate reset",
    "prisma:studio": "npx prisma studio",
    "db:seed": "npx prisma db seed",
    "prisma:test": "cross-env PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 npx prisma",
    "test:db:setup": "pnpm prisma:test generate --schema=__tests__/db/schema.prisma && pnpm prisma:test db push --schema=__tests__/db/schema.prisma",
    "test:db": "vitest run --config vitest.config.db.mts",
    "test:db:watch": "vitest --config vitest.config.db.mts",
    "test:db:clean": "cross-env NODE_ENV=test && (rm -f __tests__/db/test.db || del __tests__\\db\\test.db 2>nul || true)",
    "test:e2e": "npx playwright test",
    "test:e2e:setup": "docker compose -f docker/docker-compose.yml up -d db && cross-env CREDS_PROVIDER=true ./scripts/setup-database.sh",
    "test:e2e:build": "cross-env CREDS_PROVIDER=true pnpm build"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "Sakan Nirattisaykul",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "6.12.0",
    "@vercel/analytics": "^1.5.0",
    "next": "^15.4.4",
    "next-auth": "5.0.0-beta.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.4.4",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "19.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "9.29.0",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
